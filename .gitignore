# UniJEPA 现场 vendor / 5090 deploy（本地解压，勿 push）
docs/dagger_dev/client_thor/vendor/**
!docs/dagger_dev/client_thor/vendor/.gitkeep
# Track DAgger overlay modules only (not the full UniJEPA client tree).
!docs/dagger_dev/client_thor/vendor/remote_inference_async/
!docs/dagger_dev/client_thor/vendor/remote_inference_async/dagger_*.py
!docs/dagger_dev/client_thor/vendor/remote_inference_async/test_dagger_*.py
!docs/dagger_dev/client_thor/vendor/remote_inference_async/run_robot_dagger.sh
# Wiring for DAgger publish modes (rest of UniJEPA client stays local).
!docs/dagger_dev/client_thor/vendor/remote_inference_async/async_robot_client.py
docs/dagger_dev/server5090/deploy/

# 本机主臂 FTDI 绑定（bind_leader_arms.py）
marvin_ws/.skye/

# 本机 robot profile（set_robot_profile.sh；.skye 不可写时的回退）
marvin_ws/robot_profile

# 调试运行输出（scripts/debug/logs/.gitignore 已忽略内容）
scripts/debug/*.log
scripts/debug/logs/*
!scripts/debug/logs/.gitignore

# Hydra / 运行日志（勿提交）
marvin_ws/outputs/
marvin_ws/tele_operation/outputs/
marvin_ws/.runtime/
marvin_ws/tele_operation/.idea/

