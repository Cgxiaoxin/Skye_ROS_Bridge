<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for sky_factr_teleop.

  Why: the default participant uses builtin transports whose UDP receive
  buffer is left at the kernel default (~1 MB via net.core.rmem_default).
  Under 250 Hz joint-state traffic that overflows, truncating datagrams and
  producing "sequence size exceeds remaining buffer" on the receiving node.

  Scheme: UDPv4 with 4 MB send/receive buffers (kernel caps at
  net.core.rmem_max = 16 MB, see scripts/setup_host_tuning.sh) plus SHM for
  same-host participants.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_v4_large</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="skye_teleop_default" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_v4_large</transport_id>
        <transport_id>shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
